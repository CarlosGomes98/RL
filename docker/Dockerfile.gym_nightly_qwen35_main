# syntax=docker/dockerfile:1
# Qwen3.5/MLPerf layer for a pinned NeMo-RL main nightly Gym image.
# Keep this layer intentionally small: the nightly owns the NeMo-RL, Bridge,
# Megatron-Core, vLLM, Ray, TransformerEngine, ModelOpt, and Gym dependency set.
#
# Example:
#   docker buildx build \
#     --platform linux/arm64 \
#     --build-arg QWEN35_SOURCE_REF=$(git rev-parse HEAD) \
#     -t <registry>/optimized:nemo-rl-nightly-qwen35-ea7c4f9-<source-sha> \
#     --push \
#     -f docker/Dockerfile.gym_nightly_qwen35_main .

ARG BASE_IMAGE=nvcr.io/nvidian/nemo-rl:ea7c4f9-56705042-gym
FROM ${BASE_IMAGE}

ARG QWEN35_SOURCE_REF=unknown
ARG NEMO_GYM_PREFETCH_CONFIGS=qwen_35/configs/grpo_qwen35_397b_swe_openhands_async.yaml
ARG OPENHANDS_COMMIT=0d766ad06b2be64a42e6f0175b9ebcc4a06599d9
ARG HYBRID_EP_REVISION=e0a5b1d9848ab3e7b4a67842bf06f067bfac67f8
ARG HYBRID_EP_CUDA_ARCH_LIST="10.0;10.3"
ARG HYBRID_EP_MAX_JOBS=16

LABEL org.opencontainers.image.revision="${QWEN35_SOURCE_REF}"
LABEL com.nvidia.nemo-rl.base="nvcr.io/nvidian/nemo-rl:ea7c4f9-56705042-gym"
LABEL com.nvidia.hybrid-ep.revision="${HYBRID_EP_REVISION}"

USER root
WORKDIR /opt/nemo-rl

# The nightly's ARM DeepEP pin predates the GB300 HybridEP fixes and was built
# only for sm_90/sm_100. Rebuild the pinned HybridEP fork in the environment
# used by MegatronPolicyWorker; vLLM keeps the nightly's separate DeepEP build.
RUN <<"EOF" bash -exu -o pipefail
POLICY_VENV=/opt/ray_venvs/nemo_rl.models.policy.workers.megatron_policy_worker.MegatronPolicyWorker
POLICY_PYTHON="${POLICY_VENV}/bin/python"
HYBRID_EP_SRC=$(mktemp -d)
trap 'rm -rf "${HYBRID_EP_SRC}"' EXIT

test -x "${POLICY_PYTHON}"
git -C "${HYBRID_EP_SRC}" init
git -C "${HYBRID_EP_SRC}" fetch --depth 1 \
    https://github.com/deepseek-ai/DeepEP.git "${HYBRID_EP_REVISION}"
git -C "${HYBRID_EP_SRC}" checkout --detach FETCH_HEAD
test "$(git -C "${HYBRID_EP_SRC}" rev-parse HEAD)" = "${HYBRID_EP_REVISION}"

HYBRID_EP_MULTINODE=0 \
MAX_JOBS="${HYBRID_EP_MAX_JOBS}" \
TORCH_CUDA_ARCH_LIST="${HYBRID_EP_CUDA_ARCH_LIST}" \
USE_NIXL=0 \
    uv pip install \
        --python "${POLICY_PYTHON}" \
        --no-build-isolation \
        --no-deps \
        --reinstall \
        "${HYBRID_EP_SRC}"

"${POLICY_PYTHON}" - <<'PY'
import importlib.metadata as metadata
import importlib.util

import deep_ep

if not hasattr(deep_ep, "HybridEPBuffer"):
    raise SystemExit("deep_ep.HybridEPBuffer is unavailable")
spec = importlib.util.find_spec("hybrid_ep_cpp")
if spec is None or spec.origin is None:
    raise SystemExit("hybrid_ep_cpp extension is unavailable")
print("deep-ep", metadata.version("deep-ep"))
print("hybrid_ep_cpp", spec.origin)
PY

printf '%s\n' "${HYBRID_EP_REVISION}" > /opt/hybrid_ep_commit
EOF

COPY qwen_35/ /opt/nemo-rl/qwen_35/
COPY examples/nemo_gym/launch_qwen35_nemo_gym_multinode_training.sh \
    /opt/nemo-rl/examples/nemo_gym/launch_qwen35_nemo_gym_multinode_training.sh
# Keep the source override surface explicit. Guarded patches below carry the
# Qwen-specific runtime changes without replacing nightly modules wholesale.
# Apart from the pinned MLPerf packages installed below, dependencies and all
# other NeMo-RL modules remain from nightly.
COPY nemo_rl/algorithms/mlperf_grpo_logging.py \
    /opt/nemo-rl/nemo_rl/algorithms/mlperf_grpo_logging.py
COPY docker/gym/qwen35-gym-vllm-model.patch /tmp/qwen35-gym-vllm-model.patch
COPY docker/gym/nightly-swe-agent-apptainer-logs.patch \
    /tmp/nightly-swe-agent-apptainer-logs.patch
COPY docker/gym/nightly-gym-bounded-transient-retries.patch \
    /tmp/nightly-gym-bounded-transient-retries.patch
COPY docker/gym/qwen35-nightly-nemo-gym.patch \
    /tmp/qwen35-nightly-nemo-gym.patch
COPY docker/gym/qwen35-nightly-grpo.patch /tmp/qwen35-nightly-grpo.patch
COPY docker/gym/nightly-qwen35-multiturn-prefix.patch \
    /tmp/nightly-qwen35-multiturn-prefix.patch
COPY docker/gym/nightly-qwen35-nccl-timeout.patch \
    /tmp/nightly-qwen35-nccl-timeout.patch
COPY docker/gym/nightly-qwen35-refit-split-experts.patch \
    /tmp/nightly-qwen35-refit-split-experts.patch
COPY docker/gym/nightly-qwen35-te-sm103.patch \
    /tmp/nightly-qwen35-te-sm103.patch
COPY docker/gym/vllm-ray-v2-tcpstore-port.patch \
    /tmp/vllm-ray-v2-tcpstore-port.patch
COPY docker/gym/apply_vllm_ray_v2_tcpstore_patch.sh \
    /tmp/apply_vllm_ray_v2_tcpstore_patch.sh

RUN <<"EOF" bash -exu
cd /opt/nemo-rl/3rdparty/Gym-workspace/Gym
for patch in \
    /tmp/qwen35-gym-vllm-model.patch \
    /tmp/nightly-swe-agent-apptainer-logs.patch \
    /tmp/nightly-gym-bounded-transient-retries.patch; do
    if git apply --check "${patch}"; then
        git apply "${patch}"
    elif git apply --reverse --check "${patch}"; then
        echo "$(basename "${patch}") is already present in the nightly"
    else
        git apply --check "${patch}"
    fi
done

grep -F 'logs_dir.mkdir(parents=True, exist_ok=True)' \
    responses_api_agents/swe_agents/app.py
grep -F 'NEMO_GYM_SWE_WORKSPACE_ROOT' \
    responses_api_agents/swe_agents/app.py
grep -F 'NEMO_GYM_TRANSIENT_RETRY_SECONDS' nemo_gym/server_utils.py
python -m py_compile \
    nemo_gym/server_utils.py \
    responses_api_agents/swe_agents/app.py \
    responses_api_models/vllm_model/app.py
EOF

RUN <<"EOF" bash -exu
cd /opt/nemo-rl
for patch in \
    /tmp/nightly-qwen35-multiturn-prefix.patch \
    /tmp/nightly-qwen35-nccl-timeout.patch \
    /tmp/nightly-qwen35-refit-split-experts.patch \
    /tmp/nightly-qwen35-te-sm103.patch \
    /tmp/qwen35-nightly-nemo-gym.patch \
    /tmp/qwen35-nightly-grpo.patch; do
    if git apply --check "${patch}"; then
        git apply "${patch}"
    elif git apply --reverse --check "${patch}"; then
        echo "$(basename "${patch}") is already present in the nightly"
    else
        git apply --check "${patch}"
    fi
done

grep -F 'Treating this rollout as a masked zero-reward trajectory' \
    nemo_rl/environments/nemo_gym.py
grep -F '_qwen35_replace_prefix_from_suffix_messages' \
    nemo_rl/models/generation/vllm/vllm_worker_async.py
grep -F 'openai_serving_render=openai_serving_render' \
    nemo_rl/models/generation/vllm/vllm_worker_async.py
grep -F 'NRL_REFIT_SPLIT_FUSED_EXPERTS' \
    nemo_rl/models/policy/workers/megatron_policy_worker.py
grep -F 'NRL_NCCL_TIMEOUT_MINUTES' \
    nemo_rl/models/megatron/setup.py
grep -F 'apply_transformer_engine_sm103_flash_attention_patch' \
    nemo_rl/models/policy/workers/patches.py
grep -F 'Generation engines start with dummy weights' nemo_rl/algorithms/grpo.py
grep -F 'create_mlperf_logger' examples/nemo_gym/run_grpo_nemo_gym.py
python -m py_compile \
    examples/nemo_gym/run_grpo_nemo_gym.py \
    nemo_rl/algorithms/grpo.py \
    nemo_rl/algorithms/mlperf_grpo_logging.py \
    nemo_rl/environments/nemo_gym.py \
    nemo_rl/models/generation/vllm/vllm_backend.py \
    nemo_rl/models/generation/vllm/vllm_worker_async.py \
    nemo_rl/models/megatron/setup.py \
    nemo_rl/models/policy/workers/megatron_policy_worker.py \
    nemo_rl/models/policy/workers/patches.py
python - <<'PY'
from nemo_rl.models.generation.vllm.vllm_worker_async import _replace_prefix_tokens


class _Tokenizer:
    eos_token_id = 2

    @staticmethod
    def decode(token_ids):
        return str(token_ids)


repaired = _replace_prefix_tokens(
    tokenizer=_Tokenizer(),
    model_prefix_token_ids=[100, 101, 2],
    template_prefix_token_ids=[9, 2, 20, 2, 30],
    template_token_ids=[9, 2, 20, 2, 30],
    suffix_message_count=1,
)
assert repaired == [100, 101, 2, 20, 2, 30]
PY
EOF

RUN <<"EOF" bash -exu -o pipefail
command -v apptainer
python - <<'PY'
import importlib.metadata as metadata

print("ray", metadata.version("ray"))
PY

bash /tmp/apply_vllm_ray_v2_tcpstore_patch.sh

CONTAINER_HF_CKPT_PATH=/tmp/qwen35-hf-checkpoint \
NEMO_GYM_SWE_TRAIN_DATA_PATH=/tmp/qwen35-train.jsonl \
NEMO_GYM_SWE_VALIDATION_DATA_PATH=/tmp/qwen35-validation.jsonl \
NEMO_GYM_SWE_SIF_DIR=/tmp/qwen35-sif \
UV_LINK_MODE=copy \
    uv run python examples/nemo_gym/prefetch_venvs.py \
        ${NEMO_GYM_PREFETCH_CONFIGS}

uv pip install --python /opt/nemo_rl_venv/bin/python \
    'mlperf-common @ git+https://github.com/NVIDIA/mlperf-common.git@c02c93c0414071400a10716d9cd5cb8f668b78d4' \
    'mlperf-logging @ git+https://github.com/mlcommons/logging.git@3d17f6fb6047955159b69d9c2415317f163fbe43'

# The driver intentionally does not install the optional MCore dependency;
# Megatron is provided in policy actor environments. Verify the patched driver,
# including its explicitly pinned MLPerf dependencies, before publishing.
uv run --no-sync python -c \
    'import mlperf_common, mlperf_logging; from nemo_rl.algorithms import grpo'

/opt/nemo-rl/3rdparty/Gym-workspace/Gym/responses_api_agents/swe_agents/swe_r2e_gym_setup/R2E-Gym/venv/bin/python \
    -c 'import docker, kubernetes, openai, r2egym, rich, yaml'

python tools/generate_fingerprint.py > /opt/nemo_rl_container_fingerprint
EOF

# Keep the prebuilt OpenHands source and environment aligned with the commit
# requested by the Qwen 3.5 Gym config. The nightly currently contains a newer
# clean checkout, but per-rollout setup refuses to switch commits after the
# evaluation harness has introduced tracked changes into its writable overlay.
RUN <<"EOF" bash -exu -o pipefail
SWE_AGENTS_DIR=/opt/nemo-rl/3rdparty/Gym-workspace/Gym/responses_api_agents/swe_agents
SETUP_DIR="${SWE_AGENTS_DIR}/swe_openhands_setup"
OPENHANDS_DIR="${SETUP_DIR}/OpenHands"

SETUP_DIR="${SETUP_DIR}" \
    MINIFORGE_DIR="${SETUP_DIR}/miniforge3" \
    OPENHANDS_DIR="${OPENHANDS_DIR}" \
    AGENT_FRAMEWORK_REPO="https://github.com/sdevare-nv/nv-OpenHands.git" \
    AGENT_FRAMEWORK_COMMIT="${OPENHANDS_COMMIT}" \
        "${SWE_AGENTS_DIR}/setup_scripts/openhands.sh"

# Build tools may update tracked lockfiles. Runtime must start from the exact
# configured source commit; ignored build products such as .venv are retained.
git -C "${OPENHANDS_DIR}" reset --hard "${OPENHANDS_COMMIT}"
test "$(git -C "${OPENHANDS_DIR}" rev-parse HEAD)" = "${OPENHANDS_COMMIT}"
git -C "${OPENHANDS_DIR}" diff-index --quiet HEAD --

python tools/generate_fingerprint.py > /opt/nemo_rl_container_fingerprint
EOF

RUN chmod +x /opt/nemo-rl/examples/nemo_gym/launch_qwen35_nemo_gym_multinode_training.sh
