# syntax=docker/dockerfile:1
# Qwen3.5/MLPerf layer for a pinned NeMo-RL main nightly Gym image.
# Keep this layer intentionally small: the nightly owns the NeMo-RL, Bridge,
# Megatron-Core, vLLM, Ray, TransformerEngine, ModelOpt, and Gym dependency set.
#
# Example:
#   docker buildx build \
#     --platform linux/arm64 \
#     --build-arg QWEN35_SOURCE_REF=$(git rev-parse HEAD) \
#     -t <registry>/optimized:nemo-rl-nightly-qwen35-ea7c4f9-<source-sha> \
#     --push \
#     -f docker/Dockerfile.gym_nightly_qwen35_main .

ARG BASE_IMAGE=nvcr.io/nvidian/nemo-rl:ea7c4f9-56705042-gym
FROM ${BASE_IMAGE}

ARG QWEN35_SOURCE_REF=unknown
ARG NEMO_GYM_PREFETCH_CONFIGS=qwen_35/configs/grpo_qwen35_397b_swe_openhands_async.yaml

LABEL org.opencontainers.image.revision="${QWEN35_SOURCE_REF}"
LABEL com.nvidia.nemo-rl.base="nvcr.io/nvidian/nemo-rl:ea7c4f9-56705042-gym"

USER root
WORKDIR /opt/nemo-rl

COPY qwen_35/ /opt/nemo-rl/qwen_35/
COPY examples/nemo_gym/launch_qwen35_nemo_gym_multinode_training.sh \
    /opt/nemo-rl/examples/nemo_gym/launch_qwen35_nemo_gym_multinode_training.sh
# Keep the source override surface explicit. These files contain the Qwen async
# initialization, refit, distributed-timeout, and vLLM transport fixes carried
# by this branch; dependencies and all other NeMo-RL modules remain from nightly.
COPY nemo_rl/algorithms/grpo.py /opt/nemo-rl/nemo_rl/algorithms/grpo.py
COPY nemo_rl/models/generation/vllm/vllm_backend.py \
    /opt/nemo-rl/nemo_rl/models/generation/vllm/vllm_backend.py
COPY nemo_rl/models/generation/vllm/vllm_worker_async.py \
    /opt/nemo-rl/nemo_rl/models/generation/vllm/vllm_worker_async.py
COPY nemo_rl/models/megatron/setup.py \
    /opt/nemo-rl/nemo_rl/models/megatron/setup.py
COPY nemo_rl/models/policy/workers/megatron_policy_worker.py \
    /opt/nemo-rl/nemo_rl/models/policy/workers/megatron_policy_worker.py
COPY nemo_rl/models/policy/workers/patches.py \
    /opt/nemo-rl/nemo_rl/models/policy/workers/patches.py
COPY docker/gym/qwen35-gym-vllm-model.patch /tmp/qwen35-gym-vllm-model.patch
COPY docker/gym/nightly-swe-agent-apptainer-logs.patch \
    /tmp/nightly-swe-agent-apptainer-logs.patch
COPY docker/gym/nightly-gym-bounded-transient-retries.patch \
    /tmp/nightly-gym-bounded-transient-retries.patch
COPY docker/gym/qwen35-nightly-nemo-gym.patch \
    /tmp/qwen35-nightly-nemo-gym.patch
COPY docker/gym/vllm-ray-v2-tcpstore-port.patch \
    /tmp/vllm-ray-v2-tcpstore-port.patch
COPY docker/gym/apply_vllm_ray_v2_tcpstore_patch.sh \
    /tmp/apply_vllm_ray_v2_tcpstore_patch.sh

RUN <<"EOF" bash -exu
cd /opt/nemo-rl/3rdparty/Gym-workspace/Gym
for patch in \
    /tmp/qwen35-gym-vllm-model.patch \
    /tmp/nightly-swe-agent-apptainer-logs.patch \
    /tmp/nightly-gym-bounded-transient-retries.patch; do
    if git apply --check "${patch}"; then
        git apply "${patch}"
    elif git apply --reverse --check "${patch}"; then
        echo "$(basename "${patch}") is already present in the nightly"
    else
        git apply --check "${patch}"
    fi
done

grep -F 'logs_dir.mkdir(parents=True, exist_ok=True)' \
    responses_api_agents/swe_agents/app.py
grep -F 'NEMO_GYM_SWE_WORKSPACE_ROOT' \
    responses_api_agents/swe_agents/app.py
grep -F 'NEMO_GYM_TRANSIENT_RETRY_SECONDS' nemo_gym/server_utils.py
python -m py_compile \
    nemo_gym/server_utils.py \
    responses_api_agents/swe_agents/app.py \
    responses_api_models/vllm_model/app.py
EOF

RUN <<"EOF" bash -exu
cd /opt/nemo-rl
if git apply --check /tmp/qwen35-nightly-nemo-gym.patch; then
    git apply /tmp/qwen35-nightly-nemo-gym.patch
elif git apply --reverse --check /tmp/qwen35-nightly-nemo-gym.patch; then
    echo "qwen35-nightly-nemo-gym.patch is already present in the nightly"
else
    git apply --check /tmp/qwen35-nightly-nemo-gym.patch
fi

grep -F 'Treating this rollout as a masked zero-reward trajectory' \
    nemo_rl/environments/nemo_gym.py
grep -F '_qwen35_replace_prefix_from_suffix_messages' \
    nemo_rl/models/generation/vllm/vllm_worker_async.py
grep -F 'NRL_REFIT_SPLIT_FUSED_EXPERTS' \
    nemo_rl/models/policy/workers/megatron_policy_worker.py
grep -F 'NRL_NCCL_TIMEOUT_MINUTES' \
    nemo_rl/models/megatron/setup.py
grep -F 'apply_transformer_engine_sm103_flash_attention_patch' \
    nemo_rl/models/policy/workers/patches.py
grep -F 'collection must not' nemo_rl/algorithms/grpo.py
python -m py_compile \
    nemo_rl/algorithms/grpo.py \
    nemo_rl/environments/nemo_gym.py \
    nemo_rl/models/generation/vllm/vllm_backend.py \
    nemo_rl/models/generation/vllm/vllm_worker_async.py \
    nemo_rl/models/megatron/setup.py \
    nemo_rl/models/policy/workers/megatron_policy_worker.py \
    nemo_rl/models/policy/workers/patches.py
python - <<'PY'
from nemo_rl.models.generation.vllm.vllm_worker_async import _replace_prefix_tokens


class _Tokenizer:
    eos_token_id = 2

    @staticmethod
    def decode(token_ids):
        return str(token_ids)


repaired = _replace_prefix_tokens(
    tokenizer=_Tokenizer(),
    model_prefix_token_ids=[100, 101, 2],
    template_prefix_token_ids=[9, 2, 20, 2, 30],
    template_token_ids=[9, 2, 20, 2, 30],
    suffix_message_count=1,
)
assert repaired == [100, 101, 2, 20, 2, 30]
PY
EOF

RUN <<"EOF" bash -exu -o pipefail
command -v apptainer
python - <<'PY'
import importlib.metadata as metadata

print("ray", metadata.version("ray"))
PY

bash /tmp/apply_vllm_ray_v2_tcpstore_patch.sh

CONTAINER_HF_CKPT_PATH=/tmp/qwen35-hf-checkpoint \
NEMO_GYM_SWE_TRAIN_DATA_PATH=/tmp/qwen35-train.jsonl \
NEMO_GYM_SWE_VALIDATION_DATA_PATH=/tmp/qwen35-validation.jsonl \
NEMO_GYM_SWE_SIF_DIR=/tmp/qwen35-sif \
UV_LINK_MODE=copy \
    uv run python examples/nemo_gym/prefetch_venvs.py \
        ${NEMO_GYM_PREFETCH_CONFIGS}

/opt/nemo-rl/3rdparty/Gym-workspace/Gym/responses_api_agents/swe_agents/swe_r2e_gym_setup/R2E-Gym/venv/bin/python \
    -c 'import docker, kubernetes, openai, r2egym, rich, yaml'

python tools/generate_fingerprint.py > /opt/nemo_rl_container_fingerprint
EOF

RUN chmod +x /opt/nemo-rl/examples/nemo_gym/launch_qwen35_nemo_gym_multinode_training.sh
