# syntax=docker/dockerfile:1
# Reproducible Qwen35 Gym experiment image:
# - start from the public NeMo-RL v0.6.0 runtime image
# - replace /opt/nemo-rl with a pinned public upstream NeMo-RL main checkout
# - add the Qwen35 configs/launcher from this branch
# - apply the MLPerf/Gym patches used by the Qwen35 v0.6.0 image
#
# Example:
#   docker buildx build \
#     --platform linux/arm64 \
#     -t <registry>/optimized:nemo-rl-v0.6.0-qwen35-main-<sha> \
#     --push \
#     -f docker/Dockerfile.gym_v0.6.0_main .

ARG NRL_GIT_REF=022ae4e36be9fc68e03fbc3404ec1daf1bdf8341
ARG BASE_IMAGE=nvcr.io/nvidia/nemo-rl:v0.6.0

FROM scratch AS nemo-rl-main
ARG NRL_GIT_REF
ADD --keep-git-dir=true https://github.com/NVIDIA-NeMo/RL.git#${NRL_GIT_REF} /nemo-rl

FROM ${BASE_IMAGE}
ARG NRL_GIT_REF
ARG TARGETARCH
ARG NEMO_GYM_PREFETCH_CONFIGS=qwen_35/configs/grpo_qwen35_397b_swe_openhands_async.yaml
ARG NEMO_GYM_CUDA=
ARG NEMO_GYM_VLLM_VERSION=
ARG NEMO_RL_RAY_VERSION=2.55.1

USER root
WORKDIR /opt/nemo-rl

ENV NRL_CONTAINER=1
ENV RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
ENV NEMO_RL_VENV_DIR=/opt/ray_venvs
ENV NEMO_GYM_VENV_DIR=/opt/gym_venvs
ENV NEMO_RL_MAIN_REF=${NRL_GIT_REF}
ENV UV_PROJECT_ENVIRONMENT=/opt/nemo_rl_venv
ENV PATH="/opt/nemo_rl_venv/bin:${PATH}"
ENV CUDNN_HOME=/opt/nemo_rl_cudnn
ENV LD_LIBRARY_PATH="/opt/nemo_rl_cudnn/lib:${LD_LIBRARY_PATH}"

RUN rm -rf /opt/nemo-rl
COPY --from=nemo-rl-main /nemo-rl /opt/nemo-rl

WORKDIR /opt/nemo-rl

COPY qwen_35/ /opt/nemo-rl/qwen_35/
COPY examples/nemo_gym/launch_qwen35_nemo_gym_multinode_training.sh /opt/nemo-rl/examples/nemo_gym/launch_qwen35_nemo_gym_multinode_training.sh
COPY docker/gym/mlperf-gym.patch /tmp/mlperf-gym.patch
COPY docker/gym/qwen35-gym-vllm-model.patch /tmp/qwen35-gym-vllm-model.patch
COPY docker/gym/prefetch_venvs.py /opt/nemo-rl/examples/nemo_gym/prefetch_venvs.py

RUN <<"EOF" bash -exu -o pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends \
    ca-certificates \
    libibverbs-dev \
    software-properties-common
add-apt-repository -y ppa:apptainer/ppa
apt-get update
apt-get install -y --no-install-recommends apptainer
ln -sf /usr/bin/apptainer /usr/bin/singularity

apt-get clean
rm -rf /var/lib/apt/lists/*
EOF

RUN <<"EOF" bash -exu
cd /opt/nemo-rl/3rdparty/Gym-workspace/Gym
if git apply --check /tmp/mlperf-gym.patch; then
    git apply /tmp/mlperf-gym.patch
elif git apply --reverse --check /tmp/mlperf-gym.patch; then
    echo "mlperf-gym.patch is already applied"
else
    git apply --check /tmp/mlperf-gym.patch
fi
EOF

RUN <<"EOF" bash -exu
cd /opt/nemo-rl/3rdparty/Gym-workspace/Gym
if git apply --check /tmp/qwen35-gym-vllm-model.patch; then
    git apply /tmp/qwen35-gym-vllm-model.patch
elif git apply --reverse --check /tmp/qwen35-gym-vllm-model.patch; then
    echo "qwen35-gym-vllm-model.patch is already applied"
else
    git apply --check /tmp/qwen35-gym-vllm-model.patch
fi
EOF

RUN <<"EOF" bash -exu -o pipefail
if [[ -z "${NEMO_GYM_CUDA:-}" ]]; then
    NEMO_GYM_CUDA=$(uv run python -c "import pathlib,tomllib; indexes=tomllib.loads(pathlib.Path('pyproject.toml').read_text())['tool']['uv']['index']; print(next(i['name'].removeprefix('pytorch-') for i in indexes if i['name'].startswith('pytorch-')))")
fi

env \
    UV_TORCH_BACKEND="${NEMO_GYM_CUDA}" \
    UV_LINK_MODE=copy \
    uv run --extra nemo_gym python -c 'import nemo_gym'

uv pip install --python "${UV_PROJECT_ENVIRONMENT}/bin/python" --no-deps -e /opt/nemo-rl/3rdparty/Megatron-Bridge-workspace
uv pip install --python "${UV_PROJECT_ENVIRONMENT}/bin/python" --no-deps -e /opt/nemo-rl/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge/3rdparty/Megatron-LM
(
    cd /tmp
    "${UV_PROJECT_ENVIRONMENT}/bin/python" -m pip install --upgrade --only-binary=:all: --no-deps \
        "nvidia-modelopt>=0.39.0" \
        "pulp<4.0"
    "${UV_PROJECT_ENVIRONMENT}/bin/python" -m pip install --upgrade --only-binary=:all: \
        "onnxscript"
    "${UV_PROJECT_ENVIRONMENT}/bin/python" -m pip install --upgrade --only-binary=:all: --no-deps \
        "nvidia-cuda-cccl==13.3.3.3.1" \
        "nvidia-cuda-nvcc==13.0.88" \
        "nvidia-cuda-crt==13.0.88" \
        "nvidia-nvvm==13.0.88"
)

CUDA_HOME=$("${UV_PROJECT_ENVIRONMENT}/bin/python" - <<'PY'
import pathlib
import sysconfig

site_packages = pathlib.Path(sysconfig.get_paths()["purelib"])
matches = sorted(site_packages.glob("nvidia/cu*/bin/nvcc"))
if not matches:
    raise SystemExit("could not find pip-installed CUDA 13 nvcc")
print(matches[0].parent.parent)
PY
)
rm -rf /opt/nemo_rl_cuda
ln -s "${CUDA_HOME}" /opt/nemo_rl_cuda
export CUDA_HOME
export PATH="${CUDA_HOME}/bin:${PATH}"
if [[ ! -e "${CUDA_HOME}/lib64" && -d "${CUDA_HOME}/lib" ]]; then
    ln -s "${CUDA_HOME}/lib" "${CUDA_HOME}/lib64"
fi
NVIDIA_SITE=$("${UV_PROJECT_ENVIRONMENT}/bin/python" - <<'PY'
import pathlib
import sysconfig

print(pathlib.Path(sysconfig.get_paths()["purelib"]) / "nvidia")
PY
)
mkdir -p "${CUDA_HOME}/include" "${CUDA_HOME}/lib"
shopt -s nullglob
for component_dir in "${NVIDIA_SITE}"/*; do
    [[ -d "${component_dir}" ]] || continue
    [[ "${component_dir}" != "${CUDA_HOME}" ]] || continue
    if [[ -d "${component_dir}/include" ]]; then
        for include_entry in "${component_dir}/include"/*; do
            include_target="${CUDA_HOME}/include/${include_entry##*/}"
            [[ -e "${include_target}" || -L "${include_target}" ]] && continue
            ln -s "${include_entry}" "${include_target}"
        done
    fi
done
for versioned_lib in "${CUDA_HOME}/lib"/lib*.so.[0-9]*; do
    unversioned_lib="${versioned_lib%%.so.*}.so"
    [[ -e "${unversioned_lib}" || -L "${unversioned_lib}" ]] && continue
    ln -s "${versioned_lib##*/}" "${unversioned_lib}"
done
for cccl_entry in cuda cub thrust; do
    [[ -e "${CUDA_HOME}/include/${cccl_entry}" || -L "${CUDA_HOME}/include/${cccl_entry}" ]] && continue
    [[ -d "${CUDA_HOME}/include/cccl/${cccl_entry}" ]] || continue
    ln -s "cccl/${cccl_entry}" "${CUDA_HOME}/include/${cccl_entry}"
done
for cuda_header in nvml.h cuda_profiler_api.h; do
    [[ -e "${CUDA_HOME}/include/${cuda_header}" || -L "${CUDA_HOME}/include/${cuda_header}" ]] && continue
    for header_source in /usr/local/cuda*/targets/*/include/"${cuda_header}" /usr/local/cuda*/include/"${cuda_header}" /usr/include/"${cuda_header}"; do
        [[ -e "${header_source}" ]] || continue
        ln -s "${header_source}" "${CUDA_HOME}/include/${cuda_header}"
        break
    done
done
shopt -u nullglob
for cuda_lib_dir in "${CUDA_HOME}/lib" "${CUDA_HOME}/lib64"; do
    if [[ ! -e "${cuda_lib_dir}/libcudart.so" && -e "${cuda_lib_dir}/libcudart.so.13" ]]; then
        ln -s libcudart.so.13 "${cuda_lib_dir}/libcudart.so"
    fi
done
export LD_LIBRARY_PATH="${CUDA_HOME}/lib:${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"
export CUDA_PATH="${CUDA_HOME}"
export CUDAToolkit_ROOT="${CUDA_HOME}"
export CUDACXX="${CUDA_HOME}/bin/nvcc"
export NVTE_CUDA_ARCHS="${NVTE_CUDA_ARCHS:-100}"
export NVTE_CMAKE_EXTRA_ARGS="-DCUDAToolkit_ROOT=${CUDA_HOME} -DCMAKE_CUDA_COMPILER=${CUDA_HOME}/bin/nvcc -DCMAKE_LIBRARY_PATH=${CUDA_HOME}/lib64 -DCUDA_CUDART=${CUDA_HOME}/lib64/libcudart.so"

NVTE_FRAMEWORK=pytorch \
    uv pip install --python "${UV_PROJECT_ENVIRONMENT}/bin/python" \
        "transformer-engine[pytorch,core_cu13]>=2.1.0"

CUDNN_DIR=$(python -c "import pathlib,sysconfig; cudnn=pathlib.Path(sysconfig.get_paths()['purelib'])/'nvidia'/'cudnn'; print(cudnn if cudnn.exists() else '')")
if [[ -n "${CUDNN_DIR}" ]]; then
    rm -f /opt/nemo_rl_cudnn
    ln -s "${CUDNN_DIR}" /opt/nemo_rl_cudnn
    export CUDNN_HOME=/opt/nemo_rl_cudnn
    export LD_LIBRARY_PATH="/opt/nemo_rl_cudnn/lib:${LD_LIBRARY_PATH:-}"
fi

python - <<'PY'
import importlib.metadata as metadata

import megatron.bridge  # noqa: F401
import megatron.core  # noqa: F401
import modelopt.torch.quantization.utils  # noqa: F401
import transformer_engine.pytorch  # noqa: F401

te_version = metadata.version("transformer-engine")
te_base = te_version.split("+", 1)[0]
if tuple(int(part) for part in te_base.split(".")[:2]) < (2, 1):
    raise RuntimeError(f"transformer-engine {te_version} is too old")

print("transformer-engine", te_version)
print("nvidia-modelopt", metadata.version("nvidia-modelopt"))
PY
EOF

ENV CUDA_HOME=/opt/nemo_rl_cuda
ENV CUDA_PATH=/opt/nemo_rl_cuda
ENV CUDAToolkit_ROOT=/opt/nemo_rl_cuda
ENV CUDACXX=/opt/nemo_rl_cuda/bin/nvcc
ENV NVTE_CUDA_ARCHS=100
ENV PATH="/opt/nemo_rl_cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/nemo_rl_cuda/lib:/opt/nemo_rl_cuda/lib64:/opt/nemo_rl_cudnn/lib:${LD_LIBRARY_PATH}"

ENV NEMO_RL_RAY_VERSION=${NEMO_RL_RAY_VERSION}

RUN <<"EOF" bash -exu -o pipefail
python - <<'PY'
import os
import pathlib
import re

path = pathlib.Path("pyproject.toml")
text = path.read_text()
ray_version = os.environ["NEMO_RL_RAY_VERSION"]
text, count = re.subn(
    r'"ray\[default\](?:==|>=)[^"]+"',
    f'"ray[default]=={ray_version}"',
    text,
)
if count != 1:
    raise SystemExit(f"expected to update one ray[default] dependency, updated {count}")
path.write_text(text)
PY

uv pip install --python "${UV_PROJECT_ENVIRONMENT}/bin/python" --only-binary=:all: \
    "ray[default]==${NEMO_RL_RAY_VERSION}"

"${UV_PROJECT_ENVIRONMENT}/bin/python" - <<'PY'
import os
import ray

expected = os.environ["NEMO_RL_RAY_VERSION"]
if ray.__version__ != expected:
    raise SystemExit(f"ray version mismatch: expected {expected}, got {ray.__version__}")
print("ray", ray.__version__)
PY
EOF

RUN <<"EOF" bash -exu -o pipefail
rm -rf "${NEMO_RL_VENV_DIR}"
python -m nemo_rl.utils.prefetch_venvs \
    vllm_worker \
    async_utils \
    sync_rollout_actor \
    megatron_policy_worker \
    nemo_gym \
    --negative-filters modelopt

python - <<'PY'
import os
import pathlib
import subprocess

expected = os.environ["NEMO_RL_RAY_VERSION"]
venv_root = pathlib.Path(os.environ["NEMO_RL_VENV_DIR"])
critical_imports = {
    "nemo_rl.models.generation.vllm.vllm_worker.VllmGenerationWorker": [
        "vllm",
        "deep_ep",
    ],
    "nemo_rl.models.generation.vllm.vllm_worker_async.VllmAsyncGenerationWorker": [
        "vllm",
        "deep_ep",
    ],
    "nemo_rl.algorithms.async_utils.AsyncTrajectoryCollector": [
        "vllm",
        "deep_ep",
    ],
    "nemo_rl.algorithms.async_utils.ReplayBuffer": [
        "vllm",
        "deep_ep",
    ],
    "nemo_rl.experience.sync_rollout_actor.SyncRolloutActor": [
        "vllm",
        "deep_ep",
    ],
    "nemo_rl.models.policy.workers.megatron_policy_worker.MegatronPolicyWorker": [
        "megatron.core",
        "megatron.bridge",
        "modelopt.torch.quantization.utils",
        "transformer_engine.pytorch",
    ],
    "nemo_rl.environments.nemo_gym.NemoGym": [
        "nemo_gym",
    ],
}

for actor_fqn, modules in critical_imports.items():
    python_path = venv_root / actor_fqn / "bin" / "python"
    if not python_path.exists():
        raise SystemExit(f"missing actor venv for {actor_fqn}: {python_path}")

    script = "\n".join(
        [
            "import ray",
            f"expected = {expected!r}",
            "if ray.__version__ != expected:",
            '    raise SystemExit(f"ray version mismatch: expected {expected}, got {ray.__version__}")',
            *(f"import {module}" for module in modules),
            'print("ray", ray.__version__)',
        ]
    )
    result = subprocess.run(
        [str(python_path), "-c", script],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    output = result.stdout.strip()
    if result.returncode != 0:
        print(f"{python_path}: FAILED")
        print(output)
        raise SystemExit(result.returncode)
    print(f"{python_path}: {output}")
PY
EOF

RUN <<"EOF" bash -exu -o pipefail
if [[ -z "${NEMO_GYM_CUDA:-}" ]]; then
    NEMO_GYM_CUDA=$(uv run python -c "import pathlib,tomllib; indexes=tomllib.loads(pathlib.Path('pyproject.toml').read_text())['tool']['uv']['index']; print(next(i['name'].removeprefix('pytorch-') for i in indexes if i['name'].startswith('pytorch-')))")
fi

UV_OVERRIDE_ARGS=()
if [[ -n "${NEMO_GYM_VLLM_VERSION:-}" ]]; then
    case "${TARGETARCH:-amd64}" in
        arm64) WHEEL_ARCH=aarch64 ;;
        *) WHEEL_ARCH=x86_64 ;;
    esac
    GYM_VLLM_OVERRIDE=/tmp/gym-vllm-override.txt
    printf 'vllm @ https://github.com/vllm-project/vllm/releases/download/v%s/vllm-%s+%s-cp38-abi3-manylinux_2_35_%s.whl\n' \
        "${NEMO_GYM_VLLM_VERSION}" "${NEMO_GYM_VLLM_VERSION}" "${NEMO_GYM_CUDA}" "${WHEEL_ARCH}" > "${GYM_VLLM_OVERRIDE}"
    UV_OVERRIDE_ARGS=(UV_OVERRIDE="${GYM_VLLM_OVERRIDE}")
fi

env \
    UV_TORCH_BACKEND="${NEMO_GYM_CUDA}" \
    UV_LINK_MODE=hardlink \
    "${UV_OVERRIDE_ARGS[@]}" \
    uv run --extra nemo_gym python examples/nemo_gym/prefetch_venvs.py ${NEMO_GYM_PREFETCH_CONFIGS}
"${UV_PROJECT_ENVIRONMENT}/bin/python" - <<'PY'
import os
import ray

expected = os.environ["NEMO_RL_RAY_VERSION"]
if ray.__version__ != expected:
    raise SystemExit(f"ray version mismatch after prefetch: expected {expected}, got {ray.__version__}")
print("ray", ray.__version__)
PY

rm -f "${GYM_VLLM_OVERRIDE:-}"
EOF

RUN <<"EOF" bash -exu -o pipefail
SWE_AGENTS_DIR=/opt/nemo-rl/3rdparty/Gym-workspace/Gym/responses_api_agents/swe_agents

SETUP_DIR="${SWE_AGENTS_DIR}/swe_openhands_setup"
mkdir -p "${SETUP_DIR}"
SETUP_DIR="${SETUP_DIR}" \
    MINIFORGE_DIR="${SETUP_DIR}/miniforge3" \
    OPENHANDS_DIR="${SETUP_DIR}/OpenHands" \
    AGENT_FRAMEWORK_REPO="https://github.com/sdevare-nv/nv-OpenHands.git" \
    AGENT_FRAMEWORK_COMMIT="0d766ad06b2be64a42e6f0175b9ebcc4a06599d9" \
        "${SWE_AGENTS_DIR}/setup_scripts/openhands.sh"

SETUP_DIR="${SWE_AGENTS_DIR}/swe_swebench_setup"
mkdir -p "${SETUP_DIR}"
SETUP_DIR="${SETUP_DIR}" \
    UV_DIR="${SETUP_DIR}/uv" \
    PYTHON_DIR="${SETUP_DIR}/python" \
    SWEBENCH_DIR="${SETUP_DIR}/SWE-bench" \
    SWEBENCH_REPO="https://github.com/HeyyyyyyG/SWE-bench.git" \
    SWEBENCH_COMMIT="HEAD" \
        "${SWE_AGENTS_DIR}/setup_scripts/swebench.sh"

SETUP_DIR="${SWE_AGENTS_DIR}/swe_swebench_multilingual_setup"
mkdir -p "${SETUP_DIR}"
SETUP_DIR="${SETUP_DIR}" \
    UV_DIR="${SETUP_DIR}/uv" \
    PYTHON_DIR="${SETUP_DIR}/python" \
    SWEBENCH_DIR="${SETUP_DIR}/SWE-bench_Multilingual" \
    SWEBENCH_REPO="https://github.com/Kipok/SWE-bench.git" \
    SWEBENCH_COMMIT="HEAD" \
        "${SWE_AGENTS_DIR}/setup_scripts/swebench_multilingual.sh"

SETUP_DIR="${SWE_AGENTS_DIR}/swe_r2e_gym_setup"
mkdir -p "${SETUP_DIR}"
SETUP_DIR="${SETUP_DIR}" \
    UV_DIR="${SETUP_DIR}/uv" \
    PYTHON_DIR="${SETUP_DIR}/python" \
    R2E_GYM_DIR="${SETUP_DIR}/R2E-Gym" \
    EVAL_HARNESS_REPO="https://github.com/sdevare-nv/nv-R2E-Gym.git" \
    EVAL_HARNESS_COMMIT="local-eval" \
        "${SWE_AGENTS_DIR}/setup_scripts/r2e_gym.sh"

SETUP_DIR="${SWE_AGENTS_DIR}/swe_rebench_setup"
mkdir -p "${SETUP_DIR}"
SETUP_DIR="${SETUP_DIR}" \
    REBENCH_DIR="${SETUP_DIR}/SWE-rebench-V2" \
        "${SWE_AGENTS_DIR}/setup_scripts/swe_rebench.sh"
EOF

RUN python tools/generate_fingerprint.py > /opt/nemo_rl_container_fingerprint
