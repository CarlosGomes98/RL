+    @staticmethod
+    def _select_tcpstore_port() -> int:
+        """Keep TCPStore separate from MQ ports within NeMo's engine window.
+
+        RayExecutorV2 probes a port before constructing its broadcast
+        MessageQueue. Both allocations normally start at ``VLLM_PORT``, so the
+        MQ binds the probed port before the remote rank-zero worker can create
+        TCPStore. NeMo-RL reserves 100 ports per engine; keep the lower 64 for
+        MQ sockets and use the next 32 for TCPStore.
+        """
+        if envs.VLLM_PORT is None:
+            return get_open_port()
+
+        try:
+            return _get_open_port(
+                start_port=envs.VLLM_PORT + 64,
+                max_attempts=32,
+            )
+        except RuntimeError:
+            return get_open_port()
+
     def _init_executor(self) -> None:
