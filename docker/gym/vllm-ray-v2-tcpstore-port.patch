diff --git a/vllm/v1/executor/ray_executor_v2.py b/vllm/v1/executor/ray_executor_v2.py
--- a/vllm/v1/executor/ray_executor_v2.py
+++ b/vllm/v1/executor/ray_executor_v2.py
@@ -18,5 +18,6 @@ from vllm.logger import init_logger
 from vllm.platforms import current_platform
 from vllm.utils.network_utils import (
+    _get_open_port,
     get_distributed_init_method,
     get_open_port,
 )
@@ -245,6 +246,27 @@ class RayExecutorV2(MultiprocExecutor):
             return {"num_gpus": num_devices}
         return {"num_gpus": 0, "resources": {device_key: num_devices}}
 
+    @staticmethod
+    def _select_tcpstore_port() -> int:
+        """Keep TCPStore separate from MQ ports within NeMo's engine window.
+
+        RayExecutorV2 probes a port before constructing its broadcast
+        MessageQueue. Both allocations normally start at ``VLLM_PORT``, so the
+        MQ binds the probed port before the remote rank-zero worker can create
+        TCPStore. NeMo-RL reserves 100 ports per engine; keep the lower 64 for
+        MQ sockets and use the next 32 for TCPStore.
+        """
+        if envs.VLLM_PORT is None:
+            return get_open_port()
+
+        try:
+            return _get_open_port(
+                start_port=envs.VLLM_PORT + 64,
+                max_attempts=32,
+            )
+        except RuntimeError:
+            return get_open_port()
+
     def _init_executor(self) -> None:
         """Initialize the RayExecutorV2 executor."""
         self._finalizer = weakref.finalize(self, self.shutdown)
@@ -294,7 +316,9 @@ class RayExecutorV2(MultiprocExecutor):
         # The TCPStore server runs on rank 0's node, so all workers
         # must be able to reach this address.
         dist_ip = bundle_assignments[0]["node_ip"]
-        distributed_init_method = get_distributed_init_method(dist_ip, get_open_port())
+        distributed_init_method = get_distributed_init_method(
+            dist_ip, self._select_tcpstore_port()
+        )
 
         # Step 4: Create broadcast MessageQueue.
         # Workers on the driver node use shared memory; the rest use TCP.
diff --git a/vllm/distributed/device_communicators/shm_broadcast.py b/vllm/distributed/device_communicators/shm_broadcast.py
--- a/vllm/distributed/device_communicators/shm_broadcast.py
+++ b/vllm/distributed/device_communicators/shm_broadcast.py
@@ -408,19 +408,29 @@ class MessageQueue:
         remote_addr_ipv6 = False
         if n_remote_reader > 0:
             # for remote readers, we will:
             # create a publish-subscribe socket to communicate large data
             if not connect_ip:
                 connect_ip = get_ip()
             self.remote_socket = context.socket(XPUB)
             self.remote_socket.setsockopt(XPUB_VERBOSE, True)
-            remote_subscribe_port = get_open_port()
             if is_valid_ipv6_address(connect_ip):
                 self.remote_socket.setsockopt(IPV6, 1)
                 remote_addr_ipv6 = True
                 connect_ip = f"[{connect_ip}]"
-            socket_addr = f"tcp://{connect_ip}:{remote_subscribe_port}"
-            self.remote_socket.bind(socket_addr)
+            socket_prefix = f"tcp://{connect_ip}"
+            if envs.VLLM_PORT is None:
+                remote_subscribe_port = get_open_port()
+                self.remote_socket.bind(
+                    f"{socket_prefix}:{remote_subscribe_port}"
+                )
+            else:
+                remote_subscribe_port = self.remote_socket.bind_to_random_port(
+                    socket_prefix,
+                    min_port=envs.VLLM_PORT,
+                    max_port=envs.VLLM_PORT + 64,
+                    max_tries=128,
+                )
             remote_subscribe_addr = f"tcp://{connect_ip}:{remote_subscribe_port}"
         else:
             remote_subscribe_addr = None
             self.remote_socket = None
